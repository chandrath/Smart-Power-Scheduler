{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "_guidance": {
    "developerNote": "SINGLE SOURCE OF TRUTH (SSOT): All default configurations, metadata, versioning, and limits are managed here. The build scripts (build.ps1, release.yml) and C# runtime dynamically read from this file. To update version or branding, modify the values below. To update icons, replace Assets/master-icon.png (512x512) and run build.ps1 or Assets/Update-Icons.ps1."
  },
  "App": {
    "Name": "SmartPowerScheduler",
    "DisplayName": "Smart Power Scheduler",
    "Description": "A clean, modern Windows smart power timer and scheduler with Fluent translucent design.",
    "Version": "0.9.0.1",
    "Vendor": "Appsphinx",
    "Developer": "Shree",
    "Copyright": "Copyright © 2026 Appsphinx",
    "AppId": "9E2F9F24-B1F6-4A0B-88EE-C2A8389DB67B",
    "RepositoryUrl": "https://github.com/chandrath/Smart-Sleep-Scheduler"
  },
  "Defaults": {
    "Theme": "Dark",
    "AlwaysOnTop": true,
    "SoundEnabled": false,
    "SoundVolume": 50,
    "SoundScheme": "Modern",
    "TickTriggerSeconds": 30,
    "DefaultTimerDurationSeconds": 60,
    "AutoStartOnLaunch": true,
    "AutoStartDurationSeconds": 60,
    "DefaultPowerAction": "Sleep",
    "AllowForceActions": false,
    "MinTimerSeconds": 1,
    "MaxTimerSeconds": 43200,
    "UrgencyWarningThresholdSeconds": 30,
    "WakeUpTitle": "Welcome Back, Sleepyhead! 😴",
    "WakeUpMessage": "Your PC just enjoyed a refreshing power nap.",
    "BlockerCheckMilestonesSeconds": [
      900,
      300,
      60,
      30
    ],
    "PeriodicBlockerScanEnabled": true,
    "PeriodicBlockerScanIntervalSeconds": 5,
    "BlockerAlertSoundEnabled": true,
    "StartupBlockerAlertSoundEnabled": true,
    "MaxHistoryRecords": 100000,
    "KnownSleepBlockerProcesses": [
      "caffeine",
      "dontsleep",
      "powertoys.awake",
      "mousejiggler",
      "nosleep",
      "stayawake",
      "amphetamine"
    ]
  },
  "StreamDeck": {
    "PluginUUID": "com.appsphinx.smartpowerscheduler.sdPlugin",
    "ActionTimerUUID": "com.appsphinx.smartpowerscheduler.action.timer",
    "PluginName": "Smart Power Scheduler",
    "DefaultAction": "Sleep",
    "DefaultDuration": "30s"
  }
}
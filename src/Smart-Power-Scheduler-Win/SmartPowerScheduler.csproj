<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>SmartPowerScheduler</AssemblyName>
    <RootNamespace>SmartPowerScheduler</RootNamespace>
    <Version>0.9.0.3</Version>
    <Authors>Appsphinx</Authors>
    <Company>Appsphinx</Company>
    <Product>Smart Power Scheduler</Product>
    <Description>A clean, modern Windows smart power timer and scheduler with Fluent translucent design.</Description>
    <Copyright>Copyright © 2026 Appsphinx</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="StreamDeck.Plugin\**" />
    <EmbeddedResource Remove="StreamDeck.Plugin\**" />
    <None Remove="StreamDeck.Plugin\**" />
    <Page Remove="StreamDeck.Plugin\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <EmbeddedResource Include="Config\DevConfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <assemblyIdentity
    version="1.0.0.0"
    processorArchitecture="*"
    name="SmartPowerScheduler.StreamDeck"
    type="win32"
  />
  <description>Smart Power Scheduler Stream Deck Plugin</description>
  <asmv3:trustInfo>
    <asmv3:security>
      <asmv3:requestedPrivileges>
        <asmv3:requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </asmv3:requestedPrivileges>
    </asmv3:security>
  </asmv3:trustInfo>
  <!-- Enable loopback connections for plugin process -->
  <asmv3:application>
    <asmv3:windowsSettings>
      <ws2:loopbackExempt xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</ws2:loopbackExempt>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>

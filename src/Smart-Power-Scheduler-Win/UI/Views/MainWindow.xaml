<Window x:Class="SmartPowerScheduler.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SmartPowerScheduler.UI.Controls"
        xmlns:views="clr-namespace:SmartPowerScheduler.UI.Views"
        Title="Smart Power Scheduler"
        Width="430" Height="530"
        MinWidth="370" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="/Assets/app.ico"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Border BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <!-- Main Content Layout -->
            <Grid x:Name="MainContentGrid">
                <Grid.RowDefinitions>
                    <!-- Custom Title Bar -->
                    <RowDefinition Height="48" />
                    <!-- Update Banner (Auto: 0 height when collapsed) -->
                    <RowDefinition Height="Auto" />
                    <!-- Countdown Display Area (Scales in Viewbox) -->
                    <RowDefinition Height="*" />
                    <!-- Middle Stepper Row: [ -1m ] [ +1m ] [ ✏️ ] -->
                    <RowDefinition Height="Auto" />
                    <!-- Bottom Control Bar: [ ↺ Reset ] [ START / STOP ] [ ✕ Exit ] -->
                    <RowDefinition Height="84" />
                </Grid.RowDefinitions>

                <!-- Custom Modern Header Bar -->
                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Title & Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="/Assets/app.png" Width="20" Height="20" Margin="0,0,8,0" />
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="Smart Power"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Top Action Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <!-- Sound Effects Toggle -->
                        <Button x:Name="SoundButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="SoundButton_Click"
                                ToolTip="Sound FX (Muted / Active)">
                            <TextBlock x:Name="SoundIconText" Text="🔇" FontSize="13" />
                        </Button>

                        <!-- Always On Top Toggle -->
                        <Button x:Name="PinButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="PinButton_Click"
                                ToolTip="Always on Top (Toggle)">
                            <TextBlock x:Name="PinIconText" Text="📌" FontSize="13" />
                        </Button>

                        <!-- Fullscreen Toggle -->
                        <Button x:Name="FullscreenButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="FullscreenButton_Click"
                                ToolTip="Toggle Fullscreen (F11)">
                            <TextBlock x:Name="FullscreenIconText" Text="⛶" FontSize="14" />
                        </Button>

                        <!-- Settings Gear Icon -->
                        <Button x:Name="GearButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="GearButton_Click"
                                ToolTip="Settings">
                            <TextBlock Text="⚙" FontSize="15" />
                        </Button>

                        <!-- Minimize Button -->
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <TextBlock Text="—" FontSize="12" />
                        </Button>

                        <!-- Close Button -->
                        <Button x:Name="CloseWindowButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="CloseWindowButton_Click"
                                ToolTip="Close">
                            <TextBlock Text="✕" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Update Available Banner (Non-intrusive) -->
                <Border x:Name="UpdateBanner"
                        Grid.Row="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="16,0,16,8"
                        Padding="10,6"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✨" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="UpdateBannerText"
                                       Text="New version available!"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="UpdateBannerDownloadButton"
                                Grid.Column="1"
                                Content="Download"
                                Style="{StaticResource FluentButtonStyle}"
                                Padding="10,4"
                                FontSize="11"
                                Margin="8,0,6,0"
                                Click="UpdateBannerDownloadButton_Click" />
                        <Button x:Name="UpdateBannerDismissButton"
                                Grid.Column="2"
                                Content="✕"
                                Style="{StaticResource IconButtonStyle}"
                                Width="22"
                                Height="22"
                                Padding="0"
                                FontSize="10"
                                ToolTip="Dismiss"
                                Click="UpdateBannerDismissButton_Click" />
                    </Grid>
                </Border>

                <!-- Center: Countdown Ring Display (Scales Responsively in Viewbox) -->
                <Grid Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="16,2,16,8">
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:CountdownDisplay x:Name="CountdownControl" />
                    </Viewbox>
                </Grid>

                <!-- Middle Stepper Row: [ -1m ] [ +1m ] [ ✏️ ] [ ↺ ] -->
                <Grid Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- -1m Button (Grayed out & disabled when at 1 min) -->
                        <Button x:Name="MinusOneButton"
                                Content="-1m"
                                Style="{StaticResource FluentButtonStyle}"
                                Margin="3,0" Padding="14,7"
                                Click="MinusOneButton_Click"
                                ToolTip="Subtract 1 minute" />

                        <!-- +1m Button -->
                        <Button x:Name="PlusOneButton"
                                Content="+1m"
                                Style="{StaticResource FluentButtonStyle}"
                                Margin="3,0" Padding="14,7"
                                Click="PlusOneButton_Click"
                                ToolTip="Add 1 minute" />

                        <!-- Pencil Button to Type Custom Duration -->
                        <Button x:Name="PencilButton"
                                Style="{StaticResource FluentButtonStyle}"
                                Margin="3,0" Padding="0"
                                Width="40" Height="34"
                                Click="PencilButton_Click"
                                ToolTip="Type custom duration">
                            <TextBlock Text="✏️" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>

                        <!-- Reset Button to Default 1m -->
                        <Button x:Name="ResetButton"
                                Style="{StaticResource FluentButtonStyle}"
                                Margin="3,0" Padding="0"
                                Width="40" Height="34"
                                Click="ResetButton_Click"
                                ToolTip="Reset to default 1m duration">
                            <TextBlock Text="↺" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>

                    <!-- Sleep Blocker Warning Pill (Non-intrusive, dismissable) -->
                    <Border x:Name="BlockerWarningPill"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,-18"
                            Background="#33EF4444"
                            BorderBrush="{DynamicResource UrgencyBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,3"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            MouseDown="BlockerWarningPill_MouseDown"
                            ToolTip="Click to review options">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="BlockerWarningText"
                                       Text="Sleep blocker active"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource UrgencyBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Bottom Control Bar: Hero Full-Width [ START / STOP ] -->
                <Border Grid.Row="4"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12"
                        Padding="20,14">
                    <Grid MaxWidth="440" HorizontalAlignment="Center" Width="360">
                        <Button x:Name="PrimaryActionButton"
                                Height="48"
                                Content="START (1m)"
                                Style="{StaticResource StartButtonStyle}"
                                FontSize="16"
                                FontWeight="Bold"
                                Click="PrimaryActionButton_Click"
                                ToolTip="Start or Stop Countdown" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Wake Up / Welcome Back Overlay (Responsive Viewbox for Fullscreen) -->
            <Grid x:Name="WakeUpOverlay"
                  Background="#E6000000"
                  Visibility="Collapsed">
                <Viewbox Stretch="Uniform"
                         MaxWidth="420"
                         MaxHeight="420"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="16">
                    <views:WakeUpView x:Name="WakeUpControl" />
                </Viewbox>
            </Grid>

            <!-- Sleep Blocker Action Popover / Dialog -->
            <Grid x:Name="BlockerDialogOverlay"
                  Background="#CC000000"
                  Visibility="Collapsed">
                <Border Width="360" MaxWidth="380"
                        Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource UrgencyBrush}"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="BlockerDialogTitle"
                                   Text="⚠️ Timer Paused: Blocker Detected"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   LineHeight="19"
                                   Foreground="{DynamicResource UrgencyBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="BlockerDialogMessage"
                                   Text="An active application may prevent normal Windows power action."
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,16" />
                        <Button x:Name="CloseBlockerAndResumeButton"
                                Content="🛑 Close Blocker &amp; Resume"
                                Style="{StaticResource DangerButtonStyle}"
                                Height="38"
                                FontWeight="Bold"
                                Margin="0,0,0,8"
                                Click="CloseBlockerAndResumeButton_Click" />
                        <Button x:Name="DismissBlockerWarningButton"
                                Content="Ignore &amp; Resume Timer"
                                Style="{StaticResource FluentButtonStyle}"
                                Height="36"
                                Margin="0,0,0,8"
                                Click="DismissBlockerWarningButton_Click" />
                        <Button x:Name="StopBlockerTimerButton"
                                Content="Stop Countdown"
                                Style="{StaticResource FluentButtonStyle}"
                                Height="36"
                                Padding="8,4"
                                Opacity="0.85"
                                Click="StopBlockerTimerButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Slide-in / Modal Settings Overlay -->
            <Grid x:Name="SettingsOverlay"
                  Background="#E6000000"
                  Visibility="Collapsed">
                <views:SettingsFlyout x:Name="SettingsPanel"
                                      Width="390"
                                      Margin="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
            </Grid>

            <!-- Full History & Analytics Overlay -->
            <Grid x:Name="HistoryOverlay"
                  Background="#E6000000"
                  Visibility="Collapsed">
                <Viewbox Stretch="Uniform"
                         MaxWidth="420"
                         MaxHeight="530"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="14">
                    <views:HistoryView x:Name="HistoryControl" Width="390" Height="500" />
                </Viewbox>
            </Grid>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="SmartPowerScheduler.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="450">
    <Border Background="{DynamicResource SolidPanelBackgroundBrush}"
            BorderBrush="{DynamicResource FlyoutBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Analytics Stat Cards -->
                <RowDefinition Height="Auto" /> <!-- Filter & Actions Toolbar -->
                <RowDefinition Height="*" />    <!-- Virtualized Records List -->
                <RowDefinition Height="Auto" /> <!-- Footer with Close -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="18,16,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📊 Session History &amp; Analytics"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Review power session logs, trends, and statistics"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button x:Name="HeaderCloseButton"
                        Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Width="28"
                        Height="28"
                        Click="CloseButton_Click"
                        ToolTip="Close (Esc)">
                    <TextBlock Text="✕" FontSize="13" FontWeight="Bold" />
                </Button>
            </Grid>

            <!-- 2. Analytics 4-Card Grid -->
            <Grid Grid.Row="1" Margin="16,0,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,6"
                        Margin="0,0,4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Total" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="StatTotalText" Text="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- This Month -->
                <Border Grid.Column="1"
                        Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,6"
                        Margin="2,0,2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="This Month" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="StatMonthText" Text="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- This Year -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,6"
                        Margin="2,0,2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="This Year" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="StatYearText" Text="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Slept Hours -->
                <Border Grid.Column="3"
                        Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,6"
                        Margin="4,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Total Rest/Off" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="StatSleepTimeText" Text="0m" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Filter & Action Toolbar -->
            <StackPanel Grid.Row="2" Margin="16,0,16,8">
                <!-- Row 1: Filter + Actions -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="FilterCombo"
                              Height="28"
                              SelectionChanged="FilterCombo_SelectionChanged"
                              Margin="0,0,6,0">
                        <ComboBoxItem Content="All Actions (Default)" IsSelected="True" />
                        <ComboBoxItem Content="🌙 Sleep Only" />
                        <ComboBoxItem Content="❄️ Hibernate Only" />
                        <ComboBoxItem Content="⚡ Shutdown Only" />
                        <ComboBoxItem Content="🔄 Restart Only" />
                        <ComboBoxItem Content="📅 This Month" />
                        <ComboBoxItem Content="🗓️ This Year" />
                    </ComboBox>

                    <Button x:Name="ExportButton"
                            Grid.Column="1"
                            Content="📥 Export"
                            Height="28"
                            Padding="8,2"
                            FontSize="11"
                            Margin="0,0,4,0"
                            Style="{StaticResource FluentButtonStyle}"
                            Click="ExportButton_Click"
                            ToolTip="Export history to a JSON file" />

                    <Button x:Name="ImportButton"
                            Grid.Column="2"
                            Content="📤 Import"
                            Height="28"
                            Padding="8,2"
                            FontSize="11"
                            Margin="0,0,4,0"
                            Style="{StaticResource FluentButtonStyle}"
                            Click="ImportButton_Click"
                            ToolTip="Import and merge records from a JSON file" />

                    <Button x:Name="ShareButton"
                            Grid.Column="3"
                            Content="📋 Share"
                            Height="28"
                            Padding="8,2"
                            FontSize="11"
                            Style="{StaticResource FluentButtonStyle}"
                            Click="ShareButton_Click"
                            ToolTip="Copy summary stats to clipboard" />
                </Grid>

                <!-- Row 2: Sort + Counter -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="SortCombo"
                              Height="28"
                              SelectionChanged="SortCombo_SelectionChanged"
                              Width="180"
                              Margin="0,0,8,0">
                        <ComboBoxItem Content="⬇️ Newest First" IsSelected="True" />
                        <ComboBoxItem Content="⬆️ Oldest First" />
                        <ComboBoxItem Content="💤 Longest Sleep Time" />
                        <ComboBoxItem Content="⏱️ Longest Timer Duration" />
                    </ComboBox>

                    <TextBlock x:Name="PagingCounterText"
                               Grid.Column="1"
                               Text="Showing 0 records"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>

                <!-- Feedback Toast Text -->
                <TextBlock x:Name="FeedbackNoticeText"
                           Text=""
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,4,0,0"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- 4. Virtualized Records List -->
            <Grid Grid.Row="3" Margin="16,0,16,6">
                <!-- Empty Notice -->
                <Border x:Name="EmptyNoticePanel"
                        Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🌙" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="No session history matches this filter."
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Scheduled sessions will appear here automatically upon completion."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Virtualized ListBox for 100,000 record scalability -->
                <ListBox x:Name="RecordsListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SolidCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ActionIcon}"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ActionDisplayName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding FormattedDuration}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding FormattedDate}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource AccentGlowBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding SleepDurationVisibility}">
                                            <TextBlock Text="{Binding SleepDurationText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="9.5"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="3"
                                            Style="{StaticResource IconButtonStyle}"
                                            Width="22"
                                            Height="22"
                                            Margin="8,0,0,0"
                                            Click="DeleteRecordButton_Click"
                                            Tag="{Binding Id}"
                                            ToolTip="Delete this record"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 5. Footer -->
            <Border Grid.Row="4"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ClearAllButton"
                            Content="🗑 Clear All"
                            Style="{StaticResource FluentButtonStyle}"
                            Height="32"
                            Padding="10,4"
                            FontSize="11"
                            Click="ClearAllButton_Click"
                            ToolTip="Delete all history permanently" />
                    <Button x:Name="LoadMoreButton"
                            Grid.Column="1"
                            Content="Load More (+50)"
                            Style="{StaticResource FluentButtonStyle}"
                            Height="32"
                            Padding="12,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Click="LoadMoreButton_Click"
                            ToolTip="Load next 50 records" />
                    <Button Grid.Column="2"
                            Content="Done"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="32"
                            Padding="18,4"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>


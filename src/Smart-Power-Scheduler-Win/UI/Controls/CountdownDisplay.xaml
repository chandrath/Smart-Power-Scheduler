<UserControl x:Class="SmartPowerScheduler.UI.Controls.CountdownDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="330" d:DesignWidth="360">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
        <!-- Glowing Urgency Background Circle -->
        <Border x:Name="GlowCircle"
                Width="290" Height="290"
                CornerRadius="145"
                Opacity="0"
                Background="{DynamicResource UrgencyBrush}">
            <Border.Effect>
                <BlurEffect Radius="50" />
            </Border.Effect>
        </Border>

        <!-- Main Circular Card / Frame -->
        <Border Width="270" Height="270"
                CornerRadius="135"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1.5">
            <Grid>
                <!-- Circular Track Background -->
                <Ellipse Width="244" Height="244"
                         Stroke="{DynamicResource ButtonBackgroundBrush}"
                         StrokeThickness="9" />

                <!-- Circular Accent Track -->
                <Ellipse x:Name="ProgressTrackRing"
                         Width="244" Height="244"
                         Stroke="{DynamicResource AccentBrush}"
                         StrokeThickness="3.5"
                         Opacity="0.45" />

                <!-- Single Vertically Centered Stack: Dead-Center & Zero Clutter -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <!-- Line 1: Headline (YOUR PC WILL BE - only shown when running!) -->
                    <TextBlock x:Name="TopHeaderText"
                               Text=""
                               FontSize="22"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               Margin="0,0,0,2"
                               Visibility="Collapsed" />

                    <!-- Line 2: Action Label Pure Typography (No Pill!) -->
                    <TextBlock x:Name="ActionLabelText"
                               Text="🌙 ASLEEP"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               Margin="0,0,0,8" />

                    <!-- Dead-Center Countdown Digits with Centered Live Warning Dot -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Big Countdown Digits (Perfect Horizontal Center) -->
                        <TextBlock x:Name="TimeText"
                                   Text="01:00"
                                   FontSize="56"
                                   FontWeight="Black"
                                   Cursor="Hand"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   ToolTip="Click to type custom duration"
                                   MouseDown="TimeText_MouseDown"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" />

                        <!-- Inline Edit Box: Seamless 56pt typography with subtle accent underline -->
                        <TextBox x:Name="TimeEditBox"
                                 Text="01:00"
                                 FontSize="56"
                                 FontWeight="Black"
                                 FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                 Width="220"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 BorderThickness="0,0,0,2"
                                 BorderBrush="{DynamicResource AccentBrush}"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 Visibility="Collapsed"
                                 TextChanged="TimeEditBox_TextChanged"
                                 KeyDown="TimeEditBox_KeyDown"
                                 LostFocus="TimeEditBox_LostFocus" />

                        <!-- Live Warning Blinking Red Dot (Floats to the right of centered digits) -->
                        <Ellipse x:Name="LiveBlinkDot"
                                 Width="10" Height="10"
                                 Fill="{DynamicResource UrgencyBrush}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Margin="0,0,-18,0"
                                 Visibility="Collapsed" />
                    </Grid>

                    <!-- Status Sub-label -->
                    <TextBlock x:Name="StatusSubText"
                               Text="Scheduled Sleep"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Segoe UI Variable Text, Segoe UI" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

{
  "Author": "Appsphinx",
  "Description": "Smart Sleep Scheduler integration for Elgato Stream Deck with live countdown display and power action triggers.",
  "Name": "Smart Sleep Scheduler",
  "Icon": "images/pluginIcon",
  "Category": "Smart Sleep Scheduler",
  "CategoryIcon": "images/pluginIcon",
  "URL": "https://github.com/chandrath/Smart-Sleep-Scheduler",
  "Version": "0.9.0.3",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "4.3"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "CodePathWin": "SmartSleepScheduler.StreamDeck.exe",
  "Actions": [
    {
      "Name": "Smart Sleep Timer",
      "UUID": "com.appsphinx.smartsleepscheduler.action.timer",
      "Icon": "images/actionIcon",
      "Tooltip": "Trigger power action or view active countdown with Smart Sleep Scheduler",
      "PropertyInspectorPath": "property_inspector/inspector.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "images/actionIcon",
          "TitleAlignment": "middle",
          "FontSize": 10,
          "FontStyle": "Bold",
          "TitleColor": "#FFFFFF"
        }
      ]
    }
  ]
}

<UserControl x:Class="SmartSleepScheduler.UI.Views.SettingsFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="390">

    <Border Background="{DynamicResource SolidPanelBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Fixed Header with Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Settings &amp; Preferences"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <Button x:Name="CloseButton"
                        HorizontalAlignment="Right"
                        Style="{StaticResource IconButtonStyle}"
                        Click="CloseButton_Click"
                        ToolTip="Close Settings (Esc)">
                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold" />
                </Button>
            </Grid>

            <!-- Row 1: Scrollable Settings List -->
            <ScrollViewer x:Name="SettingsScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,6,0"
                          Margin="0,0,0,12">
                <StackPanel>
                    <!-- Section: Default Timer Duration -->
                <Border Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Default Timer Duration"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Default countdown duration when resetting or starting manually."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DefaultDurationInput"
                                     Grid.Column="0"
                                     Text="1"
                                     PreviewTextInput="NumericOnly_PreviewTextInput" />
                            <ComboBox x:Name="DefaultDurationUnitCombo"
                                      Grid.Column="2">
                                <ComboBoxItem Content="Seconds" />
                                <ComboBoxItem Content="Minutes" IsSelected="True" />
                                <ComboBoxItem Content="Hours" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Auto-Start on Launch -->
                <Border Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="AutoStartCheck"
                                  Content="Auto-start countdown on launch"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  IsChecked="True"
                                  Margin="0,0,0,6" />
                        <TextBlock Text="Starts a 1-minute countdown automatically when app opens."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AutoStartDurationInput"
                                     Grid.Column="0"
                                     Text="1"
                                     PreviewTextInput="NumericOnly_PreviewTextInput" />
                            <ComboBox x:Name="AutoStartDurationUnitCombo"
                                      Grid.Column="2">
                                <ComboBoxItem Content="Seconds" />
                                <ComboBoxItem Content="Minutes" IsSelected="True" />
                                <ComboBoxItem Content="Hours" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Window & Appearance -->
                <Border Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Window &amp; Appearance"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,8" />

                        <CheckBox x:Name="AlwaysOnTopCheck"
                                  Content="Always keep window on top"
                                  FontSize="12"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  IsChecked="True"
                                  Margin="0,0,0,10" />

                        <CheckBox x:Name="SoundEnabledCheck"
                                  Content="Enable countdown audio tick sound"
                                  FontSize="12"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  IsChecked="False"
                                  Checked="SoundEnabledCheck_Changed"
                                  Unchecked="SoundEnabledCheck_Changed"
                                  Margin="0,0,0,8" />

                        <!-- Audio Volume Slider & Scheme Panel -->
                        <StackPanel x:Name="SoundOptionsPanel" Margin="20,0,0,10">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sound Volume"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="VolumeValueText"
                                           Grid.Column="1"
                                           Text="80%"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                                <Button x:Name="TestSoundButton"
                                        Grid.Column="2"
                                        Content="▶ Test"
                                        Padding="8,2"
                                        FontSize="11"
                                        Style="{StaticResource FluentButtonStyle}"
                                        Click="TestSoundButton_Click"
                                        ToolTip="Play test sound at current volume" />
                            </Grid>
                            <Slider x:Name="SoundVolumeSlider"
                                    Minimum="10"
                                    Maximum="100"
                                    Value="80"
                                    SmallChange="5"
                                    LargeChange="10"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="False"
                                    ValueChanged="SoundVolumeSlider_ValueChanged"
                                    Margin="0,2,0,8" />

                            <TextBlock Text="Sound Tone"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,4" />
                            <ComboBox x:Name="SoundSchemeCombo"
                                      SelectionChanged="SoundSchemeCombo_SelectionChanged"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="Modern Chime (Default)" IsSelected="True" />
                                <ComboBoxItem Content="Classic Beep" />
                                <ComboBoxItem Content="Soft Tone" />
                            </ComboBox>

                            <TextBlock Text="Tick Sound Timing (Starts when time is under)"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,4" />
                            <ComboBox x:Name="TickTimingCombo"
                                      Margin="0,0,0,4">
                                <ComboBoxItem Content="10 seconds" />
                                <ComboBoxItem Content="15 seconds" />
                                <ComboBoxItem Content="20 seconds" />
                                <ComboBoxItem Content="25 seconds" />
                                <ComboBoxItem Content="30 seconds (Default)" IsSelected="True" />
                                <ComboBoxItem Content="45 seconds" />
                                <ComboBoxItem Content="60 seconds (1 minute)" />
                                <ComboBoxItem Content="2 minutes" />
                                <ComboBoxItem Content="5 minutes" />
                                <ComboBoxItem Content="Entire countdown" />
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="Theme Preference"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="Dark Mode (Default)" IsSelected="True" />
                            <ComboBoxItem Content="Light Mode" />
                            <ComboBoxItem Content="Windows System Auto" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Section: Power Action -->
                <Border Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Power Action on Expiry"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Default is safe Sleep without closing or forcing applications."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,8" />
                        <ComboBox x:Name="PowerActionCombo" SelectionChanged="PowerActionCombo_SelectionChanged">
                            <ComboBoxItem Content="Sleep (Default - Safe)" IsSelected="True" />
                            <ComboBoxItem Content="Hibernate" />
                            <ComboBoxItem Content="Shutdown (Graceful)" />
                            <ComboBoxItem Content="Restart (Graceful)" />
                            <ComboBoxItem Content="Force Shutdown (Advanced)" />
                            <ComboBoxItem Content="Force Restart (Advanced)" />
                        </ComboBox>

                        <!-- Force Action Warning Banner -->
                        <Border x:Name="ForceWarningBanner"
                                Background="#33EF4444"
                                BorderBrush="{DynamicResource UrgencyBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,10,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ForceWarningText"
                                       Text="⚠️ Warning: Force actions will terminate unsaved documents immediately."
                                       FontSize="11"
                                       Foreground="{DynamicResource UrgencyBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Section: Sleep Blocker Defense -->
                <Border Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Sleep Blocker Defense"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Defends against apps preventing sleep (Caffeine, Don't Sleep, Awake)."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,8" />

                        <CheckBox x:Name="StartupBlockerSoundCheck"
                                  Content="Alert sound if blocker found on launch"
                                  FontSize="12"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  IsChecked="True"
                                  Margin="0,0,0,8" />

                        <CheckBox x:Name="BlockerAlertSoundCheck"
                                  Content="Alarm chime when blocker pauses timer"
                                  FontSize="12"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  IsChecked="True"
                                  Margin="0,0,0,8" />

                        <CheckBox x:Name="PeriodicBlockerScanCheck"
                                  Content="Background scan for blockers"
                                  FontSize="12"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  IsChecked="True"
                                  Checked="PeriodicBlockerScanCheck_Changed"
                                  Unchecked="PeriodicBlockerScanCheck_Changed"
                                  Margin="0,0,0,6" />

                        <!-- Periodic Scan Interval Options (Visible when enabled) -->
                        <StackPanel x:Name="PeriodicScanIntervalPanel" Margin="20,0,0,0" Visibility="Visible">
                            <TextBlock Text="Scan Interval"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,4" />
                            <ComboBox x:Name="PeriodicScanIntervalCombo">
                                <ComboBoxItem Content="Every 5 seconds (Recommended)" IsSelected="True" />
                                <ComboBoxItem Content="Every 10 seconds" />
                                <ComboBoxItem Content="Every 15 seconds" />
                                <ComboBoxItem Content="Every 20 seconds" />
                                <ComboBoxItem Content="Every 30 seconds" />
                                <ComboBoxItem Content="Every 60 seconds" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section: Wake-Up Greeting -->
                <Border Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Wake-Up Greeting"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Message shown when waking up after a scheduled sleep."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,8" />
                        
                        <TextBlock Text="Title"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="WakeUpTitleInput"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="Message"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="WakeUpMessageInput" />
                    </StackPanel>
                </Border>

                <!-- Section: Session History & Stats -->
                <Border Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Session History &amp; Stats"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="HistoryTotalStatsText"
                                           Text="0 sessions recorded"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                            <Button x:Name="ShareHistoryButton"
                                    Grid.Column="1"
                                    Content="📋 Share"
                                    Padding="8,4"
                                    FontSize="11"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource FluentButtonStyle}"
                                    Click="ShareHistoryButton_Click"
                                    ToolTip="Copy session summary to clipboard" />
                            <Button x:Name="ClearHistoryButton"
                                    Grid.Column="2"
                                    Content="🗑 Clear"
                                    Padding="6,4"
                                    FontSize="11"
                                    Style="{StaticResource FluentButtonStyle}"
                                    Click="ClearHistoryButton_Click"
                                    ToolTip="Clear all session history records" />
                        </Grid>

                        <TextBlock x:Name="ShareNotificationText"
                                   Text="✓ Summary copied to clipboard!"
                                   FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,6"
                                   Visibility="Collapsed" />

                        <TextBlock x:Name="HistoryEmptyNotice"
                                   Text="No completed power sessions yet. When a countdown completes, your power event is logged here."
                                   FontSize="11"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,4" />

                        <ScrollViewer x:Name="HistoryScrollViewer"
                                      MaxHeight="170"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed">
                            <ItemsControl x:Name="HistoryItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ButtonBackgroundBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,6"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ActionIcon}"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ActionDisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding FormattedDuration}"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding FormattedDate}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource AccentGlowBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            HorizontalAlignment="Right"
                                                            Visibility="{Binding SleepDurationVisibility}">
                                                        <TextBlock Text="{Binding SleepDurationText}"
                                                                   FontSize="9.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button x:Name="ViewFullAnalyticsButton"
                                Content="📊 Open Full Analytics &amp; Records"
                                Style="{StaticResource FluentButtonStyle}"
                                Height="34"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Margin="0,8,0,0"
                                Click="ViewFullAnalyticsButton_Click"
                                ToolTip="Open full screen history with analytics, month/year filters, and import/export" />
                    </StackPanel>
                </Border>

                <!-- Section: Desktop Shortcuts & Automation -->
                <Border Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Desktop Shortcuts &amp; Automation"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Create 1-click desktop shortcuts with custom power actions and timers."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,10" />

                        <!-- Action & Duration Selectors -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="2.4*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Action" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <ComboBox x:Name="ShortcutActionCombo" SelectionChanged="ShortcutBuilder_Changed">
                                    <ComboBoxItem Content="🌙 Sleep" IsSelected="True" />
                                    <ComboBoxItem Content="❄️ Hibernate" />
                                    <ComboBoxItem Content="⚡ Shutdown" />
                                    <ComboBoxItem Content="🔄 Restart" />
                                    <ComboBoxItem Content="⚠️ Force Shutdown" />
                                    <ComboBoxItem Content="⚠️ Force Restart" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Duration" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <TextBox x:Name="ShortcutDurationValueInput"
                                         Text="30"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"
                                         TextChanged="ShortcutDurationValueInput_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Unit" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <ComboBox x:Name="ShortcutDurationUnitCombo" SelectionChanged="ShortcutBuilder_Changed">
                                    <ComboBoxItem Content="Seconds" />
                                    <ComboBoxItem Content="Minutes" IsSelected="True" />
                                    <ComboBoxItem Content="Hours" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Sound Toggle & Shortcut Name -->
                        <CheckBox x:Name="ShortcutSoundCheck"
                                  Content="Play alarm sound before action"
                                  FontSize="11.5"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  IsChecked="True"
                                  Checked="ShortcutBuilder_Changed"
                                  Unchecked="ShortcutBuilder_Changed"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="Shortcut Name" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                        <TextBox x:Name="ShortcutNameInput" Text="30m Sleep" Margin="0,0,0,8" TextChanged="ShortcutNameInput_TextChanged" />

                        <!-- Command Preview Box -->
                        <Border Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,0,0,10">
                            <TextBlock x:Name="ShortcutCommandPreviewText"
                                       Text="SmartSleepScheduler.exe -a sleep -t 30m"
                                       FontFamily="Consolas, monospace"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Buttons Row -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CreateShortcutButton"
                                    Content="✨ Create Desktop Shortcut"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Height="32"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Margin="0,0,6,0"
                                    Click="CreateShortcutButton_Click"
                                    ToolTip="Places a .lnk shortcut file on your Windows desktop" />
                            <Button x:Name="CopyCommandButton"
                                    Grid.Column="1"
                                    Content="📋 Copy"
                                    Style="{StaticResource FluentButtonStyle}"
                                    Height="32"
                                    Padding="10,2"
                                    FontSize="11"
                                    Click="CopyCommandButton_Click"
                                    ToolTip="Copy command-line arguments to clipboard" />
                        </Grid>

                        <!-- Shortcut Created Notification feedback & Open Desktop link -->
                        <Border x:Name="ShortcutFeedbackPanel"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ShortcutFeedbackText"
                                           Text="✓ Desktop shortcut created successfully!"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6" />
                                <Button x:Name="OpenDesktopFolderButton"
                                        Content="📂 Open Desktop Folder"
                                        Style="{StaticResource FluentButtonStyle}"
                                        Height="26"
                                        Padding="8,2"
                                        FontSize="10.5"
                                        HorizontalAlignment="Left"
                                        Click="OpenDesktopFolderButton_Click"
                                        ToolTip="Open Windows Desktop in File Explorer" />
                            </StackPanel>
                        </Border>

                        <!-- Collapsible Command-Line Reference Guide -->
                        <Expander Header="Command-Line Reference Guide"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  FontSize="11"
                                  Margin="0,2,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Run from terminal, batch file, or custom shortcut:" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="• -a &lt;action&gt; : sleep, hibernate, shutdown, restart" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1" />
                                <TextBlock Text="• -t &lt;duration&gt; : 30m, 1h, 45s, 1h30m, 900" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1" />
                                <TextBlock Text="• -s &lt;on|off&gt;  : enable or disable alarm chime" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1" />
                                <TextBlock Text="• --no-start    : set duration without auto-running" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Section: About (Single Source of Truth) -->
                <Border Background="{DynamicResource SolidCardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="AboutAppNameText"
                                   Text="Smart Sleep Scheduler"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="AboutVersionText"
                                   Text="Version 0.9.0.1"
                                   FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,2,0,4" />
                        <TextBlock x:Name="AboutCopyrightText"
                                   Text="Copyright © 2026 SmartSleep"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,6" />
                        <TextBlock x:Name="AboutDescText"
                                   Text="A clean, modern Windows smart sleep timer and power scheduler."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <!-- Open Settings Folder Button -->
                        <Button x:Name="OpenSettingsFolderButton"
                                Content="📂 Open Settings Folder"
                                Margin="0,10,0,0"
                                Padding="10,6"
                                FontSize="11"
                                Style="{StaticResource FluentButtonStyle}"
                                Click="OpenSettingsFolderButton_Click"
                                ToolTip="Open the %APPDATA% settings folder in Windows File Explorer" />

                        <!-- Elevation Status & Relaunch Button -->
                        <Border Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="AdminStatusText"
                                               Text="🛡️ Standard User"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="AdminDescText"
                                               Text="Admin rights enable deep kernel sleep blocker inspection."
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="RelaunchAdminButton"
                                        Grid.Column="1"
                                        Content="Relaunch as Admin"
                                        Padding="10,4"
                                        FontSize="11"
                                        Style="{StaticResource FluentButtonStyle}"
                                        Click="RelaunchAdminButton_Click"
                                        ToolTip="Restart app with Administrator elevation" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Row 2: Fixed Persistent Footer Bar -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ResetDefaultsButton"
                        Grid.Column="0"
                        Content="Reset Defaults"
                        Style="{StaticResource FluentButtonStyle}"
                        Height="38"
                        Click="ResetDefaultsButton_Click" />
                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Content="Save &amp; Close"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="38"
                        FontWeight="Bold"
                        Click="SaveButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Border>
</UserControl>

<Window x:Class="SmartSleepScheduler.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SmartSleepScheduler.UI.Controls"
        xmlns:views="clr-namespace:SmartSleepScheduler.UI.Views"
        Title="Smart Sleep Scheduler"
        Width="420" Height="520"
        MinWidth="360" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="/Assets/app.ico"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Border BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <!-- Main Content Layout -->
            <Grid x:Name="MainContentGrid">
                <Grid.RowDefinitions>
                    <!-- Custom Title Bar -->
                    <RowDefinition Height="48" />
                    <!-- Countdown Display Area -->
                    <RowDefinition Height="*" />
                    <!-- Quick Increment Preset Buttons -->
                    <RowDefinition Height="Auto" />
                    <!-- Primary Action Buttons (Stop, Pause, Reset) -->
                    <RowDefinition Height="84" />
                </Grid.RowDefinitions>

                <!-- Custom Modern Header Bar -->
                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Title & Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="/Assets/app.png" Width="20" Height="20" Margin="0,0,8,0" />
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="Smart Sleep"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Top Action Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <!-- Always On Top Toggle -->
                        <Button x:Name="PinButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="PinButton_Click"
                                ToolTip="Always on Top (Toggle)">
                            <TextBlock x:Name="PinIconText" Text="📌" FontSize="13" />
                        </Button>

                        <!-- Fullscreen Toggle -->
                        <Button x:Name="FullscreenButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="FullscreenButton_Click"
                                ToolTip="Toggle Fullscreen (F11)">
                            <TextBlock x:Name="FullscreenIconText" Text="⛶" FontSize="14" />
                        </Button>

                        <!-- Settings Gear Icon -->
                        <Button x:Name="GearButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="GearButton_Click"
                                ToolTip="Settings">
                            <TextBlock Text="⚙" FontSize="15" />
                        </Button>

                        <!-- Minimize Button -->
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <TextBlock Text="—" FontSize="12" />
                        </Button>

                        <!-- Close Button -->
                        <Button x:Name="CloseWindowButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="CloseWindowButton_Click"
                                ToolTip="Close">
                            <TextBlock Text="✕" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Center: Countdown Ring Display -->
                <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:CountdownDisplay x:Name="CountdownControl" />
                </Grid>

                <!-- Preset Quick Add Chips -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                    <Button Content="+1m"
                            Style="{StaticResource FluentButtonStyle}"
                            Margin="4,0" Padding="12,6"
                            Click="QuickAdd_Click" Tag="60"
                            ToolTip="Add 1 minute" />
                    <Button Content="+5m"
                            Style="{StaticResource FluentButtonStyle}"
                            Margin="4,0" Padding="12,6"
                            Click="QuickAdd_Click" Tag="300"
                            ToolTip="Add 5 minutes" />
                    <Button Content="+15m"
                            Style="{StaticResource FluentButtonStyle}"
                            Margin="4,0" Padding="12,6"
                            Click="QuickAdd_Click" Tag="900"
                            ToolTip="Add 15 minutes" />
                    <Button Content="+30m"
                            Style="{StaticResource FluentButtonStyle}"
                            Margin="4,0" Padding="12,6"
                            Click="QuickAdd_Click" Tag="1800"
                            ToolTip="Add 30 minutes" />
                </StackPanel>

                <!-- Bottom Primary Controls (Stop, Pause/Resume, Reset) -->
                <Border Grid.Row="3"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12"
                        Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Pause / Resume Button -->
                        <Button x:Name="PauseResumeButton"
                                Grid.Column="0"
                                Content="Pause"
                                Style="{StaticResource FluentButtonStyle}"
                                Click="PauseResumeButton_Click" />

                        <!-- Primary Dynamic Action Button (Start / Stop) -->
                        <Button x:Name="PrimaryActionButton"
                                Grid.Column="2"
                                Content="STOP (Esc)"
                                Style="{StaticResource DangerButtonStyle}"
                                FontSize="14"
                                FontWeight="Bold"
                                Click="PrimaryActionButton_Click"
                                ToolTip="Stop Countdown (Shortcut: Esc)" />

                        <!-- Reset Button -->
                        <Button x:Name="ResetButton"
                                Grid.Column="4"
                                Content="Reset"
                                Style="{StaticResource FluentButtonStyle}"
                                Click="ResetButton_Click"
                                ToolTip="Reset to default duration" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Wake Up / Welcome Back Overlay -->
            <Grid x:Name="WakeUpOverlay"
                  Background="#99000000"
                  Visibility="Collapsed">
                <views:WakeUpView x:Name="WakeUpControl"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
            </Grid>

            <!-- Slide-in / Modal Settings Overlay -->
            <Grid x:Name="SettingsOverlay"
                  Background="#66000000"
                  Visibility="Collapsed">
                <views:SettingsFlyout x:Name="SettingsPanel"
                                      Width="390"
                                      Margin="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>


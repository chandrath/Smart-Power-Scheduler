<Window x:Class="SmartSleepScheduler.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SmartSleepScheduler.UI.Controls"
        xmlns:views="clr-namespace:SmartSleepScheduler.UI.Views"
        Title="Smart Sleep Scheduler"
        Width="430" Height="530"
        MinWidth="370" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="/Assets/app.ico"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Border BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <!-- Main Content Layout -->
            <Grid x:Name="MainContentGrid">
                <Grid.RowDefinitions>
                    <!-- Custom Title Bar -->
                    <RowDefinition Height="48" />
                    <!-- Countdown Display Area (Scales in Viewbox) -->
                    <RowDefinition Height="*" />
                    <!-- Middle Stepper Row: [ -1m ] [ +1m ] [ ✏️ ] -->
                    <RowDefinition Height="Auto" />
                    <!-- Bottom Control Bar: [ ↺ Reset ] [ START / STOP ] [ ✕ Exit ] -->
                    <RowDefinition Height="84" />
                </Grid.RowDefinitions>

                <!-- Custom Modern Header Bar -->
                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Title & Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="/Assets/app.png" Width="20" Height="20" Margin="0,0,8,0" />
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="Smart Sleep"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Top Action Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <!-- Sound Effects Toggle -->
                        <Button x:Name="SoundButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="SoundButton_Click"
                                ToolTip="Sound FX (Muted / Active)">
                            <TextBlock x:Name="SoundIconText" Text="🔇" FontSize="13" />
                        </Button>

                        <!-- Always On Top Toggle -->
                        <Button x:Name="PinButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="PinButton_Click"
                                ToolTip="Always on Top (Toggle)">
                            <TextBlock x:Name="PinIconText" Text="📌" FontSize="13" />
                        </Button>

                        <!-- Fullscreen Toggle -->
                        <Button x:Name="FullscreenButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="FullscreenButton_Click"
                                ToolTip="Toggle Fullscreen (F11)">
                            <TextBlock x:Name="FullscreenIconText" Text="⛶" FontSize="14" />
                        </Button>

                        <!-- Settings Gear Icon -->
                        <Button x:Name="GearButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="GearButton_Click"
                                ToolTip="Settings">
                            <TextBlock Text="⚙" FontSize="15" />
                        </Button>

                        <!-- Minimize Button -->
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <TextBlock Text="—" FontSize="12" />
                        </Button>

                        <!-- Close Button -->
                        <Button x:Name="CloseWindowButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="CloseWindowButton_Click"
                                ToolTip="Close">
                            <TextBlock Text="✕" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Center: Countdown Ring Display (Scales Responsively in Viewbox) -->
                <Grid Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="16,2,16,8">
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:CountdownDisplay x:Name="CountdownControl" />
                    </Viewbox>
                </Grid>

                <!-- Middle Stepper Row: [ -1m ] [ +1m ] [ ✏️ ] -->
                <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- -1m Button (Grayed out & disabled when at 1 min) -->
                        <Button x:Name="MinusOneButton"
                                Content="-1m"
                                Style="{StaticResource FluentButtonStyle}"
                                Margin="4,0" Padding="14,7"
                                Click="MinusOneButton_Click"
                                ToolTip="Subtract 1 minute" />

                        <!-- +1m Button -->
                        <Button x:Name="PlusOneButton"
                                Content="+1m"
                                Style="{StaticResource FluentButtonStyle}"
                                Margin="4,0" Padding="14,7"
                                Click="PlusOneButton_Click"
                                ToolTip="Add 1 minute" />

                        <!-- Pencil Button to Type Custom Duration -->
                        <Button x:Name="PencilButton"
                                Style="{StaticResource FluentButtonStyle}"
                                Margin="4,0" Padding="0"
                                Width="40" Height="34"
                                Click="PencilButton_Click"
                                ToolTip="Type custom duration">
                            <TextBlock Text="✏️" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Bottom Control Bar: [ ↺ Reset ] [ START / STOP ] [ ✕ Exit ] -->
                <Border Grid.Row="3"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12"
                        Padding="20,14">
                    <Grid MaxWidth="440" HorizontalAlignment="Center" Width="360">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Small Round Reset Button -->
                        <Button x:Name="ResetButton"
                                Grid.Column="0"
                                Width="44" Height="44"
                                Style="{StaticResource FluentButtonStyle}"
                                Padding="0"
                                Click="ResetButton_Click"
                                ToolTip="Reset to default duration">
                            <TextBlock Text="↺" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- Center: Primary Big Action Button (Emerald Start / Red Stop) -->
                        <Button x:Name="PrimaryActionButton"
                                Grid.Column="1"
                                Margin="14,0"
                                Height="46"
                                Content="START (1m)"
                                Style="{StaticResource StartButtonStyle}"
                                FontSize="15"
                                FontWeight="Bold"
                                Click="PrimaryActionButton_Click"
                                ToolTip="Start or Stop Countdown" />

                        <!-- Right: Small Round Exit Button -->
                        <Button x:Name="ExitButton"
                                Grid.Column="2"
                                Width="44" Height="44"
                                Style="{StaticResource FluentButtonStyle}"
                                Padding="0"
                                Click="ExitButton_Click"
                                ToolTip="Exit application">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Wake Up / Welcome Back Overlay -->
            <Grid x:Name="WakeUpOverlay"
                  Background="#99000000"
                  Visibility="Collapsed">
                <views:WakeUpView x:Name="WakeUpControl"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
            </Grid>

            <!-- Slide-in / Modal Settings Overlay -->
            <Grid x:Name="SettingsOverlay"
                  Background="#99000000"
                  Visibility="Collapsed">
                <views:SettingsFlyout x:Name="SettingsPanel"
                                      Width="390"
                                      Margin="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="SmartSleepScheduler.UI.Controls.CountdownDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="330" d:DesignWidth="360">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
        <!-- Glowing Urgency Background Circle -->
        <Border x:Name="GlowCircle"
                Width="290" Height="290"
                CornerRadius="145"
                Opacity="0"
                Background="{DynamicResource UrgencyBrush}">
            <Border.Effect>
                <BlurEffect Radius="50" />
            </Border.Effect>
        </Border>

        <!-- Main Circular Card / Frame -->
        <Border Width="270" Height="270"
                CornerRadius="135"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1.5">
            <Grid>
                <!-- Circular Track Background -->
                <Ellipse Width="244" Height="244"
                         Stroke="{DynamicResource ButtonBackgroundBrush}"
                         StrokeThickness="9" />

                <!-- Circular Accent Track -->
                <Ellipse x:Name="ProgressTrackRing"
                         Width="244" Height="244"
                         Stroke="{DynamicResource AccentBrush}"
                         StrokeThickness="3.5"
                         Opacity="0.45" />

                <!-- Unified Single StackPanel: Zero Dead Space, Heavy Bold Lockup -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <!-- Heavy Bold Headline from Mockup -->
                    <TextBlock x:Name="TopHeaderText"
                               Text="YOUR PC WILL BE"
                               FontSize="27"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               Margin="0,0,0,4" />

                    <!-- Prominent Action Badge (Tight 4px Under Header) -->
                    <Border x:Name="ActionBadge"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            BorderBrush="#5538BDF8"
                            BorderThickness="1.5"
                            CornerRadius="16"
                            Padding="18,5"
                            Margin="0,0,0,6"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="ActionBadgeText"
                                   Text="🌙 SLEEP"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI" />
                    </Border>

                    <!-- Countdown Digits Row (IN + 01:00 + Live Dot) -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <!-- 'IN ' prefix -->
                        <TextBlock x:Name="InPrefixText"
                                   Text="IN "
                                   FontSize="22"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,4,0"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" />

                        <!-- Big Countdown Digits -->
                        <TextBlock x:Name="TimeText"
                                   Text="01:00"
                                   FontSize="52"
                                   FontWeight="Black"
                                   Cursor="Hand"
                                   ToolTip="Click to type custom duration"
                                   MouseDown="TimeText_MouseDown"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" />

                        <!-- Inline Edit Box (Appears only on click / pencil) -->
                        <TextBox x:Name="TimeEditBox"
                                 Text="01:00"
                                 FontSize="36"
                                 FontWeight="Black"
                                 Width="130"
                                 TextAlignment="Center"
                                 VerticalAlignment="Center"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource CardBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Visibility="Collapsed"
                                 KeyDown="TimeEditBox_KeyDown"
                                 LostFocus="TimeEditBox_LostFocus" />

                        <!-- Live Warning Blinking Red Dot (< 60s) -->
                        <Ellipse x:Name="LiveBlinkDot"
                                 Width="10" Height="10"
                                 Fill="{DynamicResource UrgencyBrush}"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Status sub-label -->
                    <TextBlock x:Name="StatusSubText"
                               Text="Scheduled Sleep"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Segoe UI Variable Text, Segoe UI" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
